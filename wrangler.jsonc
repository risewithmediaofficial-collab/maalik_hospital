{
  "name": "maalik-hospital",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "cd frontend && npm install && npm run build"
  },
  "assets": {
    "directory": "frontend/dist",
    "not_found_handling": "single-page-application"
  }
}
